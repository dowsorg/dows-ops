FROM gitlab/gitlab-runner:v16.8.1
WORKDIR /home

ENV JDK_GZ jdk-17_linux-x64_bin.tar.gz
ENV MVN_GZ apache-maven-3.9.6-bin.tar.gz
ENV SONAR_SCANNER_CLI_ZIP sonar-scanner-cli-5.0.1.3006-linux.zip

ENV JAVA_HOME /home/jdk-17.0.10
ENV MAVEN_HOME /home/maven-3.9.6
ENV SONAR_SCANNER_CLI_HOME /home/sonar-scanner-cli-5.0.1.3006

COPY ./$JDK_GZ .
COPY ./$MVN_GZ .
COPY ./$SONAR_SCANNER_CLI_ZIP .

RUN apt-get update  &&  \
    apt-get install -y locales  && \
    apt-get install -y unzip &&  \
    locale-gen "en_US.UTF-8"  &&  \
    update-locale LC_ALL="en_US.UTF-8" &&  \
    export LANG="en_US.UTF-8" && \
    tar zxf $JDK_GZ && \
    rm -f $JDK_GZ && \
    tar zxf $MVN_GZ && \
    rm -f $MVN_GZ && \
    unzip $SONAR_SCANNER_CLI_ZIP && \
    rm -f $SONAR_SCANNER_CLI_ZIP
#RUN apt-get clean -y &&  \
#    rm -rf /tmp/* /var/cache/debconf/* /var/lib/apt/lists/* /var/log/* /var/tmp/*
#RUN echo "export CLASSPATH=.:$JAVA_HOME/lib" >> /etc/profile &&  \
#    echo "export PATH=\$PATH:$JAVA_HOME/bin:$MAVEN_HOME/bin:$SONAR_SCANNER_CLI_HOME/bin" >> /etc/profile
ENV JAVA_HOME /home/$JDK_VERSION
ENV MAVEN_HOME /home/$MVN_VERSION
ENV SONAR_SCANNER_HOME /home/$SONAR_SCANNER_CLI_VERSION
ENV PATH $$PATH:$$JAVA_HOME/bin:$$MAVEN_HOME/bin:$$SONAR_SCANNER_HOME/bin

